<guideline>
    <name>BSI TR-02102-2 (v2025-01)</name>
    <link>https://www.bsi.bund.de/SharedDocs/Downloads/DE/BSI/Publikationen/TechnischeRichtlinien/TR02102/BSI-TR-02102-2.html</link>
    <analyzedPropertyGuidelineCheck>
        <name>Grundsätzlich werden TLS 1.2 und TLS 1.3 empfohlen.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <property>SUPPORTS_TLS_1_2</property>
        <result>TRUE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Grundsätzlich werden TLS 1.2 und TLS 1.3 empfohlen.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <property>SUPPORTS_TLS_1_3</property>
        <result>TRUE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>TLS 1.0 und TLS 1.1 werden nicht empfohlen.</name>
        <requirementLevel>SHOULD_NOT</requirementLevel>
        <property>SUPPORTS_TLS_1_0</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>TLS 1.0 und TLS 1.1 werden nicht empfohlen.</name>
        <requirementLevel>SHOULD_NOT</requirementLevel>
        <property>SUPPORTS_TLS_1_1</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>SSL v2 und SSL v3 werden nicht empfohlen.</name>
        <requirementLevel>SHOULD_NOT</requirementLevel>
        <property>SUPPORTS_SSL_2</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>SSL v2 und SSL v3 werden nicht empfohlen.</name>
        <requirementLevel>SHOULD_NOT</requirementLevel>
        <property>SUPPORTS_SSL_3</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <recommendedCipherSuiteGuidelineCheck>
        <name>Grundsätzlich wird empfohlen, nur Cipher-Suiten einzusetzen, die die Anforderungen an die Algorithmen und Schlüssellängen der [TR-02102-1] erfüllen.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <versions>TLS12</versions>
        <cipherSuitesInQuestion>TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_ECDSA_WITH_AES_128_CCM</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_ECDSA_WITH_AES_256_CCM</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DHE_DSS_WITH_AES_128_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DHE_DSS_WITH_AES_256_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DHE_DSS_WITH_AES_128_GCM_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DHE_DSS_WITH_AES_256_GCM_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DHE_RSA_WITH_AES_128_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DHE_RSA_WITH_AES_256_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DHE_RSA_WITH_AES_128_GCM_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DHE_RSA_WITH_AES_256_GCM_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DHE_RSA_WITH_AES_128_CCM</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DHE_RSA_WITH_AES_256_CCM</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDH_ECDSA_WITH_AES_128_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDH_ECDSA_WITH_AES_256_CBC_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDH_ECDSA_WITH_AES_128_GCM_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDH_ECDSA_WITH_AES_256_GCM_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDH_RSA_WITH_AES_128_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDH_RSA_WITH_AES_256_CBC_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDH_RSA_WITH_AES_128_GCM_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDH_RSA_WITH_AES_256_GCM_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DH_DSS_WITH_AES_128_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DH_DSS_WITH_AES_256_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DH_DSS_WITH_AES_128_GCM_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DH_DSS_WITH_AES_256_GCM_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DH_RSA_WITH_AES_128_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DH_RSA_WITH_AES_256_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DH_RSA_WITH_AES_128_GCM_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DH_RSA_WITH_AES_256_GCM_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_PSK_WITH_AES_128_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_PSK_WITH_AES_256_CBC_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_PSK_WITH_AES_128_GCM_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_PSK_WITH_AES_256_GCM_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_PSK_WITH_AES_128_CCM_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DHE_PSK_WITH_AES_128_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DHE_PSK_WITH_AES_256_CBC_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DHE_PSK_WITH_AES_128_GCM_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DHE_PSK_WITH_AES_256_GCM_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DHE_PSK_WITH_AES_128_CCM</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_DHE_PSK_WITH_AES_256_CCM</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_RSA_PSK_WITH_AES_128_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_RSA_PSK_WITH_AES_256_CBC_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_RSA_PSK_WITH_AES_128_GCM_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_RSA_PSK_WITH_AES_256_GCM_SHA384</cipherSuitesInQuestion>
    </recommendedCipherSuiteGuidelineCheck>
    <namedGroupsGuidelineCheck>
        <name>Die folgenden Diffie-Hellman Gruppen werden empfohlen.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <recommendedGroups>SECP256R1</recommendedGroups>
        <recommendedGroups>SECP384R1</recommendedGroups>
        <recommendedGroups>SECP521R1</recommendedGroups>
        <recommendedGroups>BRAINPOOLP256R1</recommendedGroups>
        <recommendedGroups>BRAINPOOLP384R1</recommendedGroups>
        <recommendedGroups>BRAINPOOLP512R1</recommendedGroups>
        <recommendedGroups>FFDHE3072</recommendedGroups>
        <recommendedGroups>FFDHE4096</recommendedGroups>
        <tls13>false</tls13>
        <minGroupCount>2</minGroupCount>
    </namedGroupsGuidelineCheck>
    <signatureAlgorithmsGuidelineCheck>
        <name>Die folgenden Signaturverfahren werden empfohlen.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_2</property>
            <result>TRUE</result>
        </condition>
        <recommendedAlgorithms>RSA_PKCS1</recommendedAlgorithms>
        <recommendedAlgorithms>RSA_SSA_PSS</recommendedAlgorithms>
        <recommendedAlgorithms>DSA</recommendedAlgorithms>
        <recommendedAlgorithms>ECDSA</recommendedAlgorithms>
    </signatureAlgorithmsGuidelineCheck>
    <recommendedHashAlgorithmsGuidelineCheck>
        <name>Die folgenden Hashfunktionen werden empfohlen.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_2</property>
            <result>TRUE</result>
        </condition>
        <algorithmsInQuestion>SHA256</algorithmsInQuestion>
        <algorithmsInQuestion>SHA384</algorithmsInQuestion>
        <algorithmsInQuestion>SHA512</algorithmsInQuestion>
    </recommendedHashAlgorithmsGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Es wird empfohlen Session Renegotiation nur auf Basis von [RFC 5746] zu verwenden. Durch den Client initiierte Renegotiation sollte vom Server abgelehnt werden.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_2</property>
            <result>TRUE</result>
        </condition>
        <property>SUPPORTS_SECURE_RENEGOTIATION_EXTENSION</property>
        <result>TRUE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Es wird empfohlen Session Renegotiation nur auf Basis von [RFC 5746] zu verwenden. Durch den Client initiierte Renegotiation sollte vom Server abgelehnt werden.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_2</property>
            <result>TRUE</result>
        </condition>
        <property>SUPPORTS_CLIENT_SIDE_SECURE_RENEGOTIATION_EXTENSION</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Es wird empfohlen Session Renegotiation nur auf Basis von [RFC 5746] zu verwenden. Durch den Client initiierte Renegotiation sollte vom Server abgelehnt werden.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_2</property>
            <result>TRUE</result>
        </condition>
        <property>SUPPORTS_CLIENT_SIDE_INSECURE_RENEGOTIATION</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <notRecommendedExtensionGuidelineCheck>
        <name>Die in [RFC 6066] definierte Extension "truncated_hmac" zur Verkürzung der Ausgabe des HMAC auf 80 Bit sollte nicht verwendet werden.</name>
        <requirementLevel>SHOULD_NOT</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_2</property>
            <result>TRUE</result>
        </condition>
        <extensionsInQuestion>TRUNCATED_HMAC</extensionsInQuestion>
    </notRecommendedExtensionGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Es wird empfohlen die TLS-Datenkompression nicht zu verwenden.</name>
        <requirementLevel>SHOULD_NOT</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_2</property>
            <result>TRUE</result>
        </condition>
        <property>SUPPORTS_TLS_COMPRESSION</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Der Einsatz der TLS-Erweiterung "Encrypt-then-MAC" gemäß [RFC 7366] wird empfohlen.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_2</property>
            <result>TRUE</result>
        </condition>
        <property>SUPPORTS_ENCRYPT_THEN_MAC</property>
        <result>TRUE</result>
    </analyzedPropertyGuidelineCheck>
    <recommendedExtensionGuidelineCheck>
        <name>Es wird empfohlen, die Heartbeat-Erweiterung nicht zu verwenden.</name>
        <requirementLevel>SHOULD_NOT</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_2</property>
            <result>TRUE</result>
        </condition>
        <extensionsInQuestion>HEARTBEAT</extensionsInQuestion>
    </recommendedExtensionGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Der Einsatz der TLS-Erweiterung Extended Master Secret gemäß [RFC 7627] wird empfohlen.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_2</property>
            <result>TRUE</result>
        </condition>
        <property>SUPPORTS_EXTENDED_MASTER_SECRET</property>
        <result>TRUE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Der PSK-Modus psk_ke bietet keine Perfect Forward Secrecy. Dieser Modus sollte daher nur in speziellen Anwendungsfällen nach Hinzuziehen eines Experten eingesetzt werden.</name>
        <requirementLevel>SHOULD_NOT</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_3</property>
            <result>TRUE</result>
        </condition>
        <property>SUPPORTS_TLS13_PSK</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Das Senden oder Annehmen von 0-RTT Daten wird nicht empfohlen.</name>
        <requirementLevel>SHOULD_NOT</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_3</property>
            <result>TRUE</result>
        </condition>
        <property>SUPPORTS_TLS13_0_RTT</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <namedGroupsGuidelineCheck>
        <name>Die folgenden Diffie-Hellman Gruppen werden empfohlen.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <recommendedGroups>SECP256R1</recommendedGroups>
        <recommendedGroups>SECP384R1</recommendedGroups>
        <recommendedGroups>SECP521R1</recommendedGroups>
        <recommendedGroups>BRAINPOOLP256R1</recommendedGroups>
        <recommendedGroups>BRAINPOOLP384R1</recommendedGroups>
        <recommendedGroups>BRAINPOOLP512R1</recommendedGroups>
        <recommendedGroups>FFDHE3072</recommendedGroups>
        <recommendedGroups>FFDHE4096</recommendedGroups>
        <tls13>true</tls13>
        <minGroupCount>2</minGroupCount>
    </namedGroupsGuidelineCheck>
    <signatureAndHashAlgorithmsGuidelineCheck>
        <name>Die folgenden Signaturverfahren werden für die "signature_algorithms" Erweiterung empfohlen.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_3</property>
            <result>TRUE</result>
        </condition>
        <recommendedAlgorithms>RSA_PSS_RSAE_SHA256</recommendedAlgorithms>
        <recommendedAlgorithms>RSA_PSS_RSAE_SHA384</recommendedAlgorithms>
        <recommendedAlgorithms>RSA_PSS_RSAE_SHA512</recommendedAlgorithms>
        <recommendedAlgorithms>RSA_PSS_PSS_SHA256</recommendedAlgorithms>
        <recommendedAlgorithms>RSA_PSS_PSS_SHA384</recommendedAlgorithms>
        <recommendedAlgorithms>RSA_PSS_PSS_SHA512</recommendedAlgorithms>
        <recommendedAlgorithms>ECDSA_SHA256</recommendedAlgorithms>
        <recommendedAlgorithms>ECDSA_SHA384</recommendedAlgorithms>
        <recommendedAlgorithms>ECDSA_SHA512</recommendedAlgorithms>
        <recommendedAlgorithms>ECDSA_BRAINPOOL_P256R1_TLS13_SHA256</recommendedAlgorithms>
        <recommendedAlgorithms>ECDSA_BRAINPOOL_P384R1_TLS13_SHA384</recommendedAlgorithms>
        <recommendedAlgorithms>ECDSA_BRAINPOOL_P512R1_TLS13_SHA512</recommendedAlgorithms>
        <tls13>true</tls13>
    </signatureAndHashAlgorithmsGuidelineCheck>
    <signatureAndHashAlgorithmsCertificateGuidelineCheck>
        <name>Die folgenden Algorithmen werden für die "signature_algorithms_cert" Erweiterung empfohlen.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_3</property>
            <result>TRUE</result>
        </condition>
        <recommendedAlgorithms>SHA256_WITH_RSA_ENCRYPTION</recommendedAlgorithms>
        <recommendedAlgorithms>SHA384_WITH_RSA_ENCRYPTION</recommendedAlgorithms>
        <recommendedAlgorithms>SHA512_WITH_RSA_ENCRYPTION</recommendedAlgorithms>
        <recommendedAlgorithms>RSASSA_PSS</recommendedAlgorithms>
        <recommendedAlgorithms>ECDSA_WITH_SHA256</recommendedAlgorithms>
        <recommendedAlgorithms>ECDSA_WITH_SHA384</recommendedAlgorithms>
        <recommendedAlgorithms>ECDSA_WITH_SHA512</recommendedAlgorithms>
    </signatureAndHashAlgorithmsCertificateGuidelineCheck>
    <recommendedCipherSuiteGuidelineCheck>
        <name>Die folgenden Cipher-Suiten werden empfohlen.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <versions>TLS13</versions>
        <cipherSuitesInQuestion>TLS_AES_128_GCM_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_AES_256_GCM_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_AES_128_CCM_SHA256</cipherSuitesInQuestion>
    </recommendedCipherSuiteGuidelineCheck>
    <keySizeCertGuidelineCheck>
        <name>Es wird empfohlen, mindestens die folgenden Schlüssellängen zu verwenden.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <atLeastOneCertificateShallPass>false</atLeastOneCertificateShallPass>
        <minimumDsaKeyLength>3000</minimumDsaKeyLength>
        <minimumRsaKeyLength>3000</minimumRsaKeyLength>
        <minimumEcKeyLength>250</minimumEcKeyLength>
        <minimumDhKeyLength>3000</minimumDhKeyLength>
    </keySizeCertGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Ephemer- bzw. Sitzungsschlüssel dürfen nur für eine Verbindung benutzt werden. (DHE)</name>
        <requirementLevel>MUST</requirementLevel>
        <condition>
            <property>SUPPORTS_DHE</property>
            <result>TRUE</result>
        </condition>
        <property>REUSES_DH_PUBLICKEY</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Ephemer- bzw. Sitzungsschlüssel dürfen nur für eine Verbindung benutzt werden. (ECDHE)</name>
        <requirementLevel>MUST</requirementLevel>
        <condition>
            <property>SUPPORTS_ECDHE</property>
            <result>TRUE</result>
        </condition>
        <property>REUSES_EC_PUBLICKEY</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
</guideline>
