<guideline>
    <name>IETF RFC 9325: Recommendations for Secure Use of Transport Layer Security (TLS) and Datagram Transport Layer Security (DTLS)</name>
    <link>https://datatracker.ietf.org/doc/rfc9325/</link>
    <analyzedPropertyGuidelineCheck>
        <name>Implementations MUST NOT negotiate SSL version 2.</name>
        <requirementLevel>MUST_NOT</requirementLevel>
        <property>SUPPORTS_SSL_2</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Implementations MUST NOT negotiate SSL version 3.</name>
        <requirementLevel>MUST_NOT</requirementLevel>
        <property>SUPPORTS_SSL_3</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Implementations MUST NOT negotiate TLS version 1.0 [RFC2246].</name>
        <requirementLevel>MUST_NOT</requirementLevel>
        <property>SUPPORTS_TLS_1_0</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Implementations MUST NOT negotiate TLS version 1.1 [RFC4346].</name>
        <requirementLevel>MUST_NOT</requirementLevel>
        <property>SUPPORTS_TLS_1_1</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Implementations MUST support TLS 1.2 [RFC5246].</name>
        <requirementLevel>MUST</requirementLevel>
        <property>SUPPORTS_TLS_1_2</property>
        <result>TRUE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Implementations SHOULD support TLS 1.3 [RFC8446].</name>
        <requirementLevel>SHOULD</requirementLevel>
        <property>SUPPORTS_TLS_1_3</property>
        <result>TRUE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>TLS/DTLS 1.2 clients MUST NOT fall back to earlier TLS versions, since those versions have been deprecated [RFC8996]. As a result, the downgrade-protection Signaling Cipher Suite Value (SCSV) mechanism [RFC7507] is no longer needed for clients.</name>
        <requirementLevel>MUST_NOT</requirementLevel>
        <condition>
            <and>
                <condition>
                    <or>
                        <condition>
                            <property>SUPPORTS_TLS_1_0</property>
                            <result>TRUE</result>
                        </condition>
                        <condition>
                            <property>SUPPORTS_TLS_1_1</property>
                            <result>TRUE</result>
                        </condition>
                    </or>
                </condition>
                <condition>
                    <property>SUPPORTS_TLS_1_3</property>
                    <result>FALSE</result>
                </condition>
            </and>
        </condition>
        <property>SUPPORTS_TLS_FALLBACK_SCSV</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>In order to help prevent compression-related attacks (summarized in Section 2.6 of [RFC7457]) when using TLS 1.2, implementations and deployments SHOULD NOT support TLS-level compression (Section 6.2.2 of [RFC5246]).</name>
        <requirementLevel>SHOULD_NOT</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_2</property>
            <result>TRUE</result>
        </condition>
        <property>SUPPORTS_TLS_COMPRESSION</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>In order to gain forward secrecy, this document recommends that server implementations SHOULD select the "psk_dhe_ke" PSK key exchange mode and **respond with a "key_share"** to complete an Ephemeral Elliptic Curve Diffie-Hellman (ECDHE) exchange on each session resumption.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_3</property>
            <result>TRUE</result>
        </condition>
        <property>SUPPORTS_TLS13_PSK_EXCHANGE_MODES</property>
        <result>TRUE</result>
    </analyzedPropertyGuidelineCheck>
    <extensionGuidelineCheck>
        <name>TLS 1.2 clients and servers MUST implement the renegotiation_info extension, as defined in [RFC5746].</name>
        <requirementLevel>MUST</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_2</property>
            <result>TRUE</result>
        </condition>
        <extensionsInQuestion>RENEGOTIATION_INFO</extensionsInQuestion>
        <required>true</required>
    </extensionGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>TLS 1.2 implementations MUST support the extended_master_secret extension defined in [RFC7627].</name>
        <requirementLevel>MUST</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_2</property>
            <result>TRUE</result>
        </condition>
        <property>SUPPORTS_EXTENDED_MASTER_SECRET</property>
        <result>TRUE</result>
    </analyzedPropertyGuidelineCheck>
    <extensionGuidelineCheck>
        <name>TLS implementations MUST support the Server Name Indication (SNI) extension defined in Section 3 of [RFC6066].</name>
        <requirementLevel>MUST</requirementLevel>
        <extensionsInQuestion>SERVER_NAME_INDICATION</extensionsInQuestion>
        <required>true</required>
    </extensionGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>In order to prevent the attacks described in [ALPACA], a server that does not recognize the presented server name SHOULD NOT continue the handshake.</name>
        <requirementLevel>SHOULD_NOT</requirementLevel>
        <property>STRICT_SNI</property>
        <result>TRUE</result>
    </analyzedPropertyGuidelineCheck>
    <extensionGuidelineCheck>
        <name>TLS implementations (both client- and server-side) MUST support the Application-Layer Protocol Negotiation (ALPN) extension [RFC7301].</name>
        <requirementLevel>MUST</requirementLevel>
        <extensionsInQuestion>ALPN</extensionsInQuestion>
        <required>true</required>
    </extensionGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>In the event that the server supports no protocols that the client advertises, then the server SHALL respond with a fatal 'no_application_protocol' alert.</name>
        <requirementLevel>MUST</requirementLevel>
        <property>STRICT_ALPN</property>
        <result>TRUE</result>
    </analyzedPropertyGuidelineCheck>
