    <cipherSuiteGuidelineCheck>
        <name>Given the foregoing considerations, implementation and deployment of the following cipher suites is RECOMMENDED.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_2</property>
            <result>TRUE</result>
        </condition>
        <versions>TLS12</versions>
        <cipherSuitesInQuestion>TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384</cipherSuitesInQuestion>
        <recommended>true</recommended>
    </cipherSuiteGuidelineCheck>
    <cipherSuiteGuidelineCheck>
        <name>A cipher suite that operates in CBC (cipher block chaining) mode (e.g., TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256) SHOULD NOT be used unless the encrypt_then_mac extension [RFC7366] is also successfully negotiated. This requirement applies to both client and server implementations.</name>
        <requirementLevel>SHOULD_NOT</requirementLevel>
        <condition>
            <and>
                <condition>
                    <property>SUPPORTS_TLS_1_2</property>
                    <result>TRUE</result>
                </condition>
                <condition>
                    <property>SUPPORTS_ENCRYPT_THEN_MAC</property>
                    <result>FALSE</result>
                </condition>
            </and>
        </condition>
        <versions>TLS12</versions>
        <cipherSuitesInQuestion>TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA384</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256</cipherSuitesInQuestion>
        <cipherSuitesInQuestion>TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA384</cipherSuitesInQuestion>
        <recommended>false</recommended>
    </cipherSuiteGuidelineCheck>
    <certificateCurveGuidelineCheck>
        <name>When using ECDSA signatures for authentication of TLS peers, it is RECOMMENDED that implementations use the NIST curve P-256.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <atLeastOneCertificateShallPass>false</atLeastOneCertificateShallPass>
        <recommendedNamedParameters>SECP256R1</recommendedNamedParameters>
    </certificateCurveGuidelineCheck>
    <cipherSuiteGuidelineCheck>
        <name>The previous version of the TLS recommendations [RFC7525] implicitly allowed [...] TLS_RSA_WITH_AES_128_CBC_SHA. [...] As with other cipher suites that do not provide forward secrecy, implementations SHOULD NOT support this cipher suite.</name>
        <requirementLevel>SHOULD_NOT</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_2</property>
            <result>TRUE</result>
        </condition>
        <versions>TLS12</versions>
        <cipherSuitesInQuestion>TLS_RSA_WITH_AES_128_CBC_SHA</cipherSuitesInQuestion>
        <recommended>false</recommended>
    </cipherSuiteGuidelineCheck>
    <extensionGuidelineCheck>
        <name>Both clients and servers SHOULD include the "Supported Elliptic Curves Extension" [RFC8422].</name>
        <requirementLevel>SHOULD</requirementLevel>
        <extensionsInQuestion>ELLIPTIC_CURVES</extensionsInQuestion>
        <required>true</required>
    </extensionGuidelineCheck>
    <namedGroupsGuidelineCheck>
        <name>Clients and servers SHOULD support the NIST P‑256 (secp256r1) [RFC8422] and X25519 (x25519) [RFC7748] curves.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <recommendedGroups>SECP256R1</recommendedGroups>
        <recommendedGroups>ECDH_X25519</recommendedGroups>
        <tls13>false</tls13>
