                    <property>SUPPORTS_TLS_1_3</property>
                    <result>TRUE</result>
                </condition>
            </or>
        </condition>
        <affectedExtensions>SIGNATURE_AND_HASH_ALGORITHMS</affectedExtensions>
    </extensionGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>The client shall be configured to use the Certificate Status Request extension.</name>
        <requirementLevel>MUST</requirementLevel>
        <property>SUPPORTS_CERTIFICATE_STATUS_REQUEST</property>
        <result>TRUE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>The Fallback Signaling Cipher Suite Value (SCSV) shall be supported if the client supports versions of TLS prior to TLS 1.2 and does not support TLS 1.3.</name>
        <requirementLevel>MUST</requirementLevel>
        <condition>
            <and>
                <condition>
                    <or>
                        <condition>
                            <property>SUPPORTS_TLS_1_0</property>
                            <result>TRUE</result>
                        </condition>
                        <condition>
                            <property>SUPPORTS_TLS_1_1</property>
                            <result>TRUE</result>
                        </condition>
                    </or>
                </condition>
                <condition>
                    <property>SUPPORTS_TLS_1_3</property>
                    <result>FALSE</result>
                </condition>
            </and>
        </condition>
        <property>SUPPORTS_TLS_FALLBACK_SCSV</property>
        <result>TRUE</result>
    </analyzedPropertyGuidelineCheck>
    <extensionGuidelineCheck>
        <name>The Supported Groups extension shall be supported if the client supports ephemeral ECDH cipher suites or if the client supports TLS 1.3.</name>
        <requirementLevel>MUST</requirementLevel>
        <condition>
            <or>
                <condition>
                    <property>SUPPORTS_ECDHE</property>
                    <result>TRUE</result>
                </condition>
                <condition>
                    <property>SUPPORTS_TLS_1_3</property>
                    <result>TRUE</result>
                </condition>
            </or>
        </condition>
        <affectedExtensions>ELLIPTIC_CURVES</affectedExtensions>
    </extensionGuidelineCheck>
    <extensionGuidelineCheck>
        <name>The Key Share extension shall be supported if the client supports TLS 1.3.</name>
        <requirementLevel>MUST</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_3</property>
            <result>TRUE</result>
        </condition>
        <affectedExtensions>KEY_SHARE</affectedExtensions>
    </extensionGuidelineCheck>
    <extensionGuidelineCheck>
        <name>The EC Point Format TLS extension shall be supported if the client supports EC cipher suite(s).</name>
        <requirementLevel>MUST</requirementLevel>
        <condition>
            <and>
                <condition>
                    <or>
                        <condition>
                            <property>SUPPORTS_TLS_1_0</property>
                            <result>TRUE</result>
                        </condition>
                        <condition>
                            <property>SUPPORTS_TLS_1_1</property>
                            <result>TRUE</result>
                        </condition>
                        <condition>
                            <property>SUPPORTS_TLS_1_2</property>
                            <result>TRUE</result>
                        </condition>
                    </or>
                </condition>
                <condition>
                    <or>
                        <condition>
                            <property>SUPPORTS_STATIC_ECDH</property>
                            <result>TRUE</result>
                        </condition>
                        <condition>
                            <property>SUPPORTS_ECDHE</property>
                            <result>TRUE</result>
                        </condition>
                    </or>
                </condition>
            </and>
        </condition>
        <affectedExtensions>EC_POINT_FORMATS</affectedExtensions>
    </extensionGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>The Multiple Certificate Status extension should be enabled if the extension is supported by the client implementation.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <condition>
            <or>
                <condition>
                    <property>SUPPORTS_TLS_1_0</property>
                    <result>TRUE</result>
                </condition>
                <condition>
                    <property>SUPPORTS_TLS_1_1</property>
                    <result>TRUE</result>
                </condition>
                <condition>
                    <property>SUPPORTS_TLS_1_2</property>
                    <result>TRUE</result>
                </condition>
            </or>
        </condition>
        <property>SUPPORTS_CERTIFICATE_STATUS_REQUEST_V2</property>
        <result>TRUE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>The Encrypt-then-MAC extension shall be supported when CBC mode cipher suites are configured.</name>
        <requirementLevel>MUST</requirementLevel>
        <condition>
            <and>
                <condition>
                    <or>
                        <condition>
                            <property>SUPPORTS_TLS_1_0</property>
                            <result>TRUE</result>
                        </condition>
                        <condition>
                            <property>SUPPORTS_TLS_1_1</property>
                            <result>TRUE</result>
                        </condition>
                        <condition>
                            <property>SUPPORTS_TLS_1_2</property>
                            <result>TRUE</result>
                        </condition>
                    </or>
                </condition>
                <condition>
                    <property>SUPPORTS_CBC</property>
                    <result>TRUE</result>
                </condition>
            </and>
        </condition>
        <property>SUPPORTS_ENCRYPT_THEN_MAC</property>
        <result>TRUE</result>
    </analyzedPropertyGuidelineCheck>
    <extensionGuidelineCheck>
        <name>The Pre-Shared Key extension may be supported by TLS 1.3 clients.</name>
        <requirementLevel>MAY</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_3</property>
            <result>TRUE</result>
        </condition>
        <affectedExtensions>PRE_SHARED_KEY</affectedExtensions>
    </extensionGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>The Pre-Shared Key Exchange Modes extension shall be supported by TLS 1.3 clients that support the Pre-Shared Key extension.</name>
        <requirementLevel>MUST</requirementLevel>
        <condition>
            <and>
                <condition>
                    <or>
                        <condition>
                            <property>SUPPORTS_TLS13_PSK</property>
                            <result>TRUE</result>
                        </condition>
                        <condition>
                            <property>SUPPORTS_TLS13_PSK_DHE</property>
                            <result>TRUE</result>
                        </condition>
                    </or>
                </condition>
                <condition>
                    <property>SUPPORTS_TLS_1_3</property>
                    <result>TRUE</result>
                </condition>
            </and>
        </condition>
        <property>SUPPORTS_TLS13_PSK_EXCHANGE_MODES</property>
        <result>TRUE</result>
    </analyzedPropertyGuidelineCheck>
    <extensionGuidelineCheck>
        <name>The Supported Versions extension shall be supported by TLS 1.3 clients.</name>
        <requirementLevel>MUST</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_3</property>
            <result>TRUE</result>
        </condition>
        <affectedExtensions>SUPPORTED_VERSIONS</affectedExtensions>
    </extensionGuidelineCheck>
    <extensionGuidelineCheck>
        <name>The Cookie extension shall be supported by TLS 1.3 clients.</name>
        <requirementLevel>MUST</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_3</property>
            <result>TRUE</result>
        </condition>
        <affectedExtensions>COOKIE</affectedExtensions>
    </extensionGuidelineCheck>
    <extensionGuidelineCheck>
        <name>The Certificate Signature Algorithms Extension shall be supported if the client supports TLS 1.3.</name>
        <requirementLevel>MUST</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_3</property>
            <result>TRUE</result>
        </condition>
        <affectedExtensions>SIGNATURE_ALGORITHMS_CERT</affectedExtensions>
    </extensionGuidelineCheck>
    <extensionGuidelineCheck>
        <name>The Certificate Signature Algorithms Extension should be supported for TLS 1.2.</name>
        <requirementLevel>SHOULD</requirementLevel>
        <condition>
            <and>
                <condition>
                    <property>SUPPORTS_TLS_1_2</property>
                    <result>TRUE</result>
                </condition>
                <condition>
                    <property>SUPPORTS_TLS_1_3</property>
                    <result>FALSE</result>
                </condition>
            </and>
        </condition>
        <affectedExtensions>SIGNATURE_ALGORITHMS_CERT</affectedExtensions>
    </extensionGuidelineCheck>
    <extensionGuidelineCheck>
        <name>The Post-handshake Client Authentication extension may be supported if the client supports TLS 1.3.</name>
        <requirementLevel>MAY</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_3</property>
            <result>TRUE</result>
        </condition>
        <affectedExtensions>POST_HANDSHAKE_AUTH</affectedExtensions>
    </extensionGuidelineCheck>
    <extensionGuidelineCheck>
        <name>The Client Certificate URL extension should not be used.</name>
        <requirementLevel>SHOULD_NOT</requirementLevel>
        <affectedExtensions>CLIENT_CERTIFICATE_URL</affectedExtensions>
    </extensionGuidelineCheck>
    <extensionGuidelineCheck>
        <name>The Early Data Indication extension should not be used.</name>
        <requirementLevel>SHOULD_NOT</requirementLevel>
        <affectedExtensions>EARLY_DATA</affectedExtensions>
    </extensionGuidelineCheck>
    <extensionGuidelineCheck>
        <name>The Raw Public Key extension shall not be supported.</name>
        <requirementLevel>MUST_NOT</requirementLevel>
        <affectedExtensions>CLIENT_CERTIFICATE_TYPE</affectedExtensions>
        <affectedExtensions>SERVER_CERTIFICATE_TYPE</affectedExtensions>
    </extensionGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>Clients using TLS 1.3 should not send 0-RTT data.</name>
        <requirementLevel>SHOULD_NOT</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_3</property>
            <result>TRUE</result>
        </condition>
        <property>SUPPORTS_TLS13_0_RTT</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>TLS 1.2 clients shall not use False Start.</name>
        <requirementLevel>MUST</requirementLevel>
        <condition>
            <property>SUPPORTS_TLS_1_2</property>
            <result>TRUE</result>
        </condition>
        <property>SUPPORTS_HTTP_FALSE_START</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
    <analyzedPropertyGuidelineCheck>
        <name>The null compression method shall be enabled, and all other compression methods shall be disabled.</name>
        <requirementLevel>MUST</requirementLevel>
        <property>SUPPORTS_TLS_COMPRESSION</property>
        <result>FALSE</result>
    </analyzedPropertyGuidelineCheck>
</guideline>
